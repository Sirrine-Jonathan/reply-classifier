# Which classifier the service uses: "heuristic" (default, no API key needed)
# or "llm" (requires a real provider wired into app/llm_client.py).
CLASSIFIER=heuristic

# --- LLM provider settings (only used when CLASSIFIER=llm) ---
# Leave blank for the scaffold; the stub client raises a clear error until a
# real provider is implemented. NEVER commit a real key.
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
